# ==============================================================================
# INTELLIPRIVART — ENVIRONMENT CONFIGURATION TEMPLATE
# The Data Moat | Case B | Nextute EdTech × Finance Club, IIT Patna
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL DEPLOYMENT (Frontend Next.js)
# In your Vercel Project -> Settings -> Environment Variables, add:
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL:
NEXT_PUBLIC_API_URL=https://intelliparivart.onrender.com/api
BACKEND_INTERNAL_URL=https://intelliparivart.onrender.com/api

# ------------------------------------------------------------------------------
# 2. RENDER DEPLOYMENT (Backend FastAPI Web Service)
# In your Render Service -> Environment -> Environment Variables, add:
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase or Render Postgres):
# e.g.: postgresql+psycopg2://postgres.xxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///data/intelliprivart.db

# Security & App Mode:
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-32-char-string-for-jwt-signing
FASTAPI_PORT=8000

# Optional Generative AI (Deterministic fallback runs for free with 0 API keys):
DEFAULT_LLM_PROVIDER=DETERMINISTIC_FALLBACK
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 3. LOCAL DEVELOPMENT DEFAULTS
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///data/intelliprivart.db
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# ENVIRONMENT=demo
# SECRET_KEY=demo-secret-key-datamoat-2026-iitpatna
