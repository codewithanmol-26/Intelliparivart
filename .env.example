# ==============================================================================
# INTELLIPRIVART MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Nextute EdTech × Finance Club, IIT Patna | Case B: The Data Moat
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Security Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
SECRET_KEY=your-production-secret-key-min-32-chars-long
JWT_SECRET_KEY=your-production-jwt-secret-key-min-32-chars-long
FASTAPI_PORT=8000
STREAMLIT_SERVER_PORT=8501

# ------------------------------------------------------------------------------
# 2. Database Configuration
# - Local SQLite default: sqlite:///data/intelliprivart.db
# - Production PostgreSQL (Supabase / Render):
#   postgresql+psycopg2://postgres.xxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///data/intelliprivart.db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=datamoat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Frontend & API Gateway Configuration
# Deployed Production Render Backend
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://intelliparivart.onrender.com/api
BACKEND_INTERNAL_URL=https://intelliparivart.onrender.com/api

# ------------------------------------------------------------------------------
# 4. Generative AI Layer Credentials
# (Optional: deterministic expert engine operates 100% free with 0 API keys)
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=DETERMINISTIC_FALLBACK
GEMINI_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Meta WhatsApp Business Cloud API
# (Optional: internal sandbox simulator activates automatically when tokens are blank)
# ------------------------------------------------------------------------------
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=intelliprivart_webhook_verify_2026
