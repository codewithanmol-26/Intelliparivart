# Data Moat Configuration
# AI-Powered Institute Intelligence Platform

# Database Configuration
# Production uses PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/datamoat
# Development / Local fallback defaults to SQLite if PostgreSQL is not running: sqlite:///datamoat.db
DATABASE_URL=sqlite:///datamoat.db

# PostgreSQL Specifics (used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datamoat
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Settings
ENVIRONMENT=demo
SECRET_KEY=demo-secret-key-datamoat-2026-iitpatna
STREAMLIT_SERVER_PORT=8501
FASTAPI_PORT=8000

# Optional Generative AI Credentials (If not provided, built-in deterministic pedagogical engine activates)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=DETERMINISTIC_FALLBACK
