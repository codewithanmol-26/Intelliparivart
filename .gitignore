# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.env
.venv/
venv/
ENV/
env/

# Databases & Lock Files (Initialize on boot via models/migrations, do not track in Git)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Large Synthetic Data Tables (Regenerable on demand via run_ml_pipeline.py)
Intelliprivart_ML/data/synthetic/*.csv
data/synthetic/*.csv

# Local Duplicate Bundles (Root files are the authoritative submission copies)
Final_Submission_Deliverables/
Intelliprivart_DataMoat_Round1-2.pptx
Nextute_Case_B_Financial_Model.xlsx

# Generated Reports & Scratch
scratch/
generated_reports/*.pdf
*.log

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/.turbo/
.turbo/
dist/
build/
data/*.csv
