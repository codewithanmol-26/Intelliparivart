# ==============================================================================
# INTELLIPRIVART FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Local Development (default when running npm run dev locally):
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
BACKEND_INTERNAL_URL=http://127.0.0.1:8000/api

# 2. Production on Vercel:
# Note: frontend/.env.production is automatically committed to point to Render.
# In Vercel Project Settings -> Environment Variables, you can also set:
# NEXT_PUBLIC_API_URL=https://intelliparivart.onrender.com/api
# BACKEND_INTERNAL_URL=https://intelliparivart.onrender.com/api
